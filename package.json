{
  "name": "ai-information-nexus",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.18.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "node scripts/prepare-standalone.mjs",
    "start": "node scripts/start-standalone.mjs",
    "start:next": "next start",
    "ingest:sources": "node scripts/call-ingest-endpoint.mjs",
    "ingest:article": "node scripts/ingest-single-article.mjs",
    "verify:ingest": "node scripts/verify-ingest-policy.mjs",
    "apk:sync": "cap sync android",
    "apk:open": "cap open android",
    "apk:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-apk.ps1",
    "apk:debug": "cd android && gradlew.bat assembleDebug",
    "apk:release": "cd android && gradlew.bat assembleRelease",
    "github:login": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/push-main.ps1 -LoginOnly",
    "push:main": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/push-main.ps1",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.4",
    "@capacitor/cli": "^8.3.4",
    "@capacitor/core": "^8.3.4",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fast-xml-parser": "^5.8.0",
    "lucide-react": "^0.555.0",
    "next": "^16.1.6",
    "postgres": "^3.4.9",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwind-merge": "^3.4.0",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.22",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.1.6",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.18",
    "typescript": "^5.9.3"
  }
}
