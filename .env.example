# Railway will inject PORT automatically. Do not hard-code it.
NODE_ENV=production

# Public base URL of the Railway web service, used by the scheduled ingest service.
# Example: https://ai-daily-production.up.railway.app
APP_BASE_URL=

# Required in production for /api/cron/ingest and scripts/call-ingest-endpoint.mjs.
CRON_SECRET=
AUTH_SESSION_SECRET=
ADMIN_EMAILS=your-email@example.com

# Recommended in production: use a shared Postgres database for auth users so
# multi-instance Railway deployments do not split registration and login data.
DATABASE_URL=

# Optional: enables MiniMax-generated AI comments, summaries and editor notes.
MINIMAX_API_KEY=
MINIMAX_TEXT_MODEL=MiniMax-M2.5
MINIMAX_BASE_URL=https://api.minimaxi.com/v1

# Optional source fetching controls and persistent data directory.
SOURCE_FETCH_LIMIT=12
SOURCE_ITEMS_PER_SOURCE=6
GITHUB_SKILL_LIMIT=8
SUBMITTED_SOURCE_LIMIT=8
DOUYIN_SOURCE_LIMIT=12
DOUYIN_ITEMS_PER_SOURCE=2
BACKUP_VIDEO_SOURCE_LIMIT=6
BACKUP_VIDEO_ITEMS_PER_SOURCE=2
# Optional: custom RSSHub for Bilibili RSS fallback. If empty, Bilibili direct API is tried first.
RSSHUB_BASE_URL=
GENERATED_FEED_LIMIT=120
GENERATED_WORKS_LIMIT=200
GITHUB_TOKEN=
# Optional: Product Hunt API 2.0 token for "有点意思" AI product ingestion.
# Create a developer token in Product Hunt, then set it in Railway.
PRODUCT_HUNT_TOKEN=
PRODUCT_HUNT_DAILY_LIMIT=20
PRODUCT_HUNT_WEEKLY_LIMIT=50
# Optional: itch.io browser-playable AI game ingestion for "有点意思".
ITCHIO_SOURCE_LIMIT=24
ITCHIO_REVIEW_LIMIT=70
ITCHIO_PUBLISH_LIMIT=10
# Optional: YouTube AI finished-work ingestion for "有点意思".
YOUTUBE_WORKS_SOURCE_LIMIT=20
YOUTUBE_WORKS_ITEM_LIMIT=5
YOUTUBE_WORKS_PUBLISH_LIMIT=10
# Recommended on Railway: mount a Volume at /data, then set AIQ_DATA_DIR=/data.
# Generated feeds, registered users and auth sessions are stored here.
AIQ_DATA_DIR=/data
HOSTNAME_BIND=0.0.0.0
AUTO_INGEST_ENABLED=true
AUTO_INGEST_INTERVAL_MINUTES=15
AUTO_INGEST_INITIAL_DELAY_MS=10000
AIQ_USER_AGENT=AIQ/1.0 (+https://github.com/jiangcheng-1992/AiDaily)

# Optional: Google AdSense. Fill these after your site is approved in AdSense.
# Example client format: ca-pub-1234567890123456
NEXT_PUBLIC_GOOGLE_ADSENSE_CLIENT=ca-pub-6821198896914466
NEXT_PUBLIC_GOOGLE_ADSENSE_FEED_SLOT=
NEXT_PUBLIC_GOOGLE_ADSENSE_SIDEBAR_SLOT=4376617489
NEXT_PUBLIC_GOOGLE_ADSENSE_DETAIL_SLOT=
